APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:Rjl1tj9eoygKKtvBqWkVV7y9SAPvKe4l2Mjp9AMT1/U=
APP_DEBUG=true
APP_URL=http://localhost
TOKEN=7hq9ybkRaVxINfHvB907nUjEPcfGf8wzjCa7XyAh
VITE_TOKEN=7hq9ybkRaVxINfHvB907nUjEPcfGf8wzjCa7XyAh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ===============================
# ❌ DATABASE COMPLETELY REMOVED
# ===============================
DB_CONNECTION=null

# ===============================
# ✅ SESSION (FILES BASED)
# ===============================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ===============================
# ✅ CACHE (FILES BASED)
# ===============================
CACHE_STORE=file

# ===============================
# ✅ QUEUE (SYNC – NO DB)
# ===============================
QUEUE_CONNECTION=sync

# ===============================
# BROADCAST
# ===============================
BROADCAST_CONNECTION=log

# ===============================
# FILE STORAGE
# ===============================
FILESYSTEM_DISK=local

# ===============================
# MAIL (LOG ONLY)
# ===============================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ===============================
# REDIS DISABLED
# ===============================
REDIS_CLIENT=null

# ===============================
# AWS (OPTIONAL)
# ===============================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ===============================
# VITE
# ===============================
VITE_APP_NAME="${APP_NAME}"
